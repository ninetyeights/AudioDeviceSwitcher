<Window x:Class="AudioDeviceSwitcher.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本" SizeToContent="Height" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FFFFFF">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="发现新版本" FontSize="16" FontWeight="SemiBold" Foreground="#111827"/>
        <TextBlock x:Name="VersionText" Grid.Row="1" Margin="0,8,0,0" FontSize="12" Foreground="#374151"/>

        <TextBlock Grid.Row="2" Text="更新内容：" Margin="0,14,0,4" FontSize="12" FontWeight="SemiBold" Foreground="#374151"/>
        <Border Grid.Row="3" BorderBrush="#E5E7EB" BorderThickness="1" MaxHeight="220" Background="#F9FAFB">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" Margin="8" TextWrapping="Wrap" FontSize="12" Foreground="#374151"/>
            </ScrollViewer>
        </Border>

        <StackPanel x:Name="ProgressPanel" Grid.Row="4" Margin="0,10,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="DownloadProgress" Height="6" Minimum="0" Maximum="1"/>
            <TextBlock x:Name="ProgressText" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="SkipButton" Grid.Column="0" Content="跳过此版本" HorizontalAlignment="Left"
                    Padding="12,6" Click="Skip_Click"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="LaterButton" Content="以后再说" Padding="12,6" Margin="0,0,8,0" Click="Later_Click"/>
                <Button Content="在浏览器中查看" Padding="12,6" Margin="0,0,8,0" Click="OpenBrowser_Click"/>
                <Button x:Name="UpdateButton" Content="立即更新" Padding="16,6" Click="Update_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
