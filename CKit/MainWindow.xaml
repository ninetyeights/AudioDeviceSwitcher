<Window Style="{StaticResource AppWindow}" x:Class="AudioDeviceSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="&#x97F3;&#x9891;&#x5207;&#x6362;&#x52A9;&#x624B;" Height="640" Width="760" MinWidth="680" MinHeight="480"
        Icon="pack://application:,,,/Resources/app.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="DeviceButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F9FAFB"/>
                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DefaultDeviceButton" TargetType="Button" BasedOn="{StaticResource DeviceButton}">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProfileCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="ActiveProfileCard" TargetType="Border" BasedOn="{StaticResource ProfileCard}">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ProfileApplyButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LinkFocus" CornerRadius="3" BorderBrush="Transparent" BorderThickness="1">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="LinkFocus" Property="BorderBrush" Value="#2563EB"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="LinkFocus" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#111827"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,6,0,4"/>
        </Style>
        <Style x:Key="MenuIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#6B7280"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="#FFFFFF">
        <Border DockPanel.Dock="Top" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
        <Menu Background="Transparent" Padding="4,2">
            <MenuItem Header="&#x6587;&#x4EF6;">
                <MenuItem Header="&#x5237;&#x65B0;" Click="Refresh_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE72C;"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="&#x5BFC;&#x51FA;音频方案&#x2026;" Click="ExportConfig_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE74E;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="&#x5BFC;&#x5165;音频方案&#x2026;" Click="ImportConfig_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8B5;"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="&#x9000;&#x51FA;" Click="ExitApp_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE711;"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="&#x89C6;&#x56FE;">
                <MenuItem Header="音频预设" Click="OpenAppProfiles_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE71D;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="&#x5E94;&#x7528;&#x97F3;&#x9891;" Click="OpenAppAudio_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE767;"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="&#x5DE5;&#x5177;">
                <MenuItem Header="定时切换音频方案…" Click="OpenProfileSchedules_Click"/>
                <MenuItem Header="系统音量合成器" Click="OpenVolumeMixer_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE9E9;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="&#x7CFB;&#x7EDF;&#x58F0;&#x97F3;" Click="OpenSoundSettings_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE767;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="&#x8BBE;&#x7F6E;&#x2026;" Click="OpenSettings_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE713;"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="&#x5E2E;&#x52A9;">
                <MenuItem Header="&#x68C0;&#x67E5;&#x66F4;&#x65B0;&#x2026;" Click="CheckForUpdates_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE896;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="&#x5173;&#x4E8E;&#x2026;" Click="OpenAbout_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE946;"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>
        </Border>
        <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Profiles + Voicemeeter (left/right) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

        <!-- Profiles Section -->
        <Border x:Name="ProfileSection" Grid.Column="0" CornerRadius="6" Padding="0"
                BorderThickness="0" BorderBrush="Transparent" Background="Transparent">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="音频方案"/>
                    <Border x:Name="ProfileWarningText" Grid.Row="1" Grid.ColumnSpan="2"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed"
                            Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                            CornerRadius="4" Padding="8,3">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#DC2626"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="&#x5F53;&#x524D;&#x8BBE;&#x5907;&#x4E0D;&#x5339;&#x914D;&#x4EFB;&#x4F55;音频方案"
                                       FontSize="11" Foreground="#991B1B" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="Tag" Value="Blink">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard Name="ProfileWarningBlink">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1.0" To="0.55" Duration="0:0:0.8"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="ProfileWarningBlink"/>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border x:Name="AppRouteStatusHeader" Grid.Row="2" Grid.ColumnSpan="2"
                            Margin="0,6,0,8" Visibility="Collapsed" CornerRadius="5"
                            Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <ToggleButton x:Name="AppRouteDetailsToggle" HorizontalContentAlignment="Stretch"
                                          Padding="10,8" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                          Checked="AppRouteDetails_Toggled" Unchecked="AppRouteDetails_Toggled"
                                          AutomationProperties.Name="展开或收起应用路由状态">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="#64748B" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="▸"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=AppRouteDetailsToggle}" Value="True">
                                                        <Setter Property="Text" Value="▾"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="应用路由状态" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                        <TextBlock x:Name="AppDriftWarningText" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="#64748B" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </ToggleButton>
                            <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,8,10,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=AppRouteDetailsToggle}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border Margin="19,0,0,0" BorderBrush="#CBD5E1" BorderThickness="2,0,0,0" Padding="10,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="应用 / 输入输出状态" FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>
                                        <TextBox x:Name="AppRouteDetailsText" IsReadOnly="True" TextWrapping="Wrap"
                                                 MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                 BorderThickness="0" Background="Transparent" Foreground="#475569"
                                                 FontSize="12" Padding="0" AutomationProperties.Name="应用路由详情，可选择并复制"/>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="1" Content="+ &#x65B0;&#x5EFA;" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Center"
                            HorizontalAlignment="Right" Click="NewProfile_Click"/>
                </Grid>
                <ItemsControl x:Name="ProfileList" Margin="0,4,0,4"/>
                <TextBlock x:Name="ProfileEmptyHint"
                           Text="&#x70B9;&#x51FB;&#x4E0A;&#x65B9;&#x7684; + &#x65B0;&#x5EFA; &#x521B;&#x5EFA;&#x7B2C;&#x4E00;&#x4E2A;音频方案"
                           FontSize="12" Foreground="#9CA3AF"
                           HorizontalAlignment="Center" Margin="0,8,0,6"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Voicemeeter Status (right of profiles) -->
        <StackPanel x:Name="VoicemeeterPanel" Grid.Column="1" Margin="12,0,0,0"
                    MinWidth="220" MaxWidth="320" VerticalAlignment="Top" Visibility="Collapsed">
            <DockPanel Margin="0,6,0,4">
                <Ellipse Width="6" Height="6" Fill="#7C3AED" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                <Button x:Name="VoicemeeterLockBtn" DockPanel.Dock="Right" Click="VoicemeeterLock_Click"
                        Padding="6,2" FontSize="13" Cursor="Hand" Background="Transparent"
                        BorderThickness="0" VerticalAlignment="Center"/>
                <TextBlock x:Name="VoicemeeterTypeText" Style="{StaticResource SectionHeader}" Margin="0"
                           Foreground="#5B21B6" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            </DockPanel>
            <Border Background="#F5F3FF" BorderBrush="#C4B5FD" BorderThickness="1"
                    CornerRadius="6" Padding="12,10" Margin="0,4,0,4">
                <ItemsControl x:Name="VoicemeeterIoList"/>
            </Border>
        </StackPanel>
        </Grid>

        <!-- Playback / Recording Devices (left/right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Playback header -->
            <DockPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Style="{StaticResource SectionHeader}" Text="&#x64AD;&#x653E;&#x8BBE;&#x5907;" DockPanel.Dock="Left"/>
                <TextBlock x:Name="PlaybackHiddenCount" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"
                           Margin="6,0,0,0" DockPanel.Dock="Left" Visibility="Collapsed"/>
                <CheckBox x:Name="ShowHiddenCheck" Content="&#x663E;&#x793A;&#x5DF2;&#x9690;&#x85CF;" FontSize="11"
                          Foreground="#6B7280"
                          VerticalAlignment="Center" Margin="12,0,0,0" DockPanel.Dock="Left"
                          Checked="ShowHidden_Changed" Unchecked="ShowHidden_Changed"/>
                <CheckBox x:Name="ShowDisabledCheck" Content="&#x663E;&#x793A;&#x5DF2;&#x7981;&#x7528;" FontSize="11"
                          Foreground="#6B7280"
                          VerticalAlignment="Center" Margin="10,0,0,0" DockPanel.Dock="Left"
                          Checked="ShowDisabled_Changed" Unchecked="ShowDisabled_Changed"/>
            </DockPanel>
            <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PlaybackList" Margin="0,0,6,0"/>
            </ScrollViewer>

            <!-- Recording header -->
            <DockPanel Grid.Row="0" Grid.Column="2" LastChildFill="False">
                <TextBlock Style="{StaticResource SectionHeader}" Text="&#x5F55;&#x97F3;&#x8BBE;&#x5907;" DockPanel.Dock="Left"/>
                <TextBlock x:Name="RecordingHiddenCount" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"
                           Margin="6,0,0,0" DockPanel.Dock="Left" Visibility="Collapsed"/>
            </DockPanel>
            <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RecordingList" Margin="0,0,6,0"/>
            </ScrollViewer>
        </Grid>

        <!-- Bluetooth Warning -->
        <Border x:Name="BluetoothWarning" Grid.Row="2" Background="#FFFBEB" BorderBrush="#FCD34D"
                BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,4,0,4" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="#D97706" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="&#x84DD;&#x7259;&#x8BBE;&#x5907;&#x5DF2;&#x8FDE;&#x63A5;" FontSize="11"
                           Foreground="#92400E" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        </Grid>
    </DockPanel>
</Window>
