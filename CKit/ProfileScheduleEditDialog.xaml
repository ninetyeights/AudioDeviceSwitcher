<Window Style="{StaticResource AppWindow}" x:Class="AudioDeviceSwitcher.ProfileScheduleEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建定时计划" Width="490" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="White">
    <StackPanel Margin="20">
        <TextBlock Text="选择音频方案和执行时间" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <TextBlock Text="目标音频方案" Margin="0,0,0,5"/>
        <ComboBox x:Name="ProfileChoice" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,12"/>
        <TextBlock Text="执行时间（24 小时制，例如 18:30）" Margin="0,0,0,5"/>
        <TextBox x:Name="TimeInput" Text="09:00" Padding="6" Margin="0,0,0,12"/>
        <TextBlock Text="重复方式" Margin="0,0,0,5"/>
        <ComboBox x:Name="RepeatChoice" SelectedIndex="0" SelectionChanged="Repeat_Changed" Margin="0,0,0,8">
            <ComboBoxItem Content="每天"/><ComboBoxItem Content="指定星期"/><ComboBoxItem Content="仅一次"/>
        </ComboBox>
        <DatePicker x:Name="OnceDate" Visibility="Collapsed" Margin="0,0,0,8"/>
        <WrapPanel x:Name="WeekdaysPanel" Visibility="Collapsed" Margin="0,0,0,8"/>
        <CheckBox x:Name="EnabledCheck" Content="启用此计划" IsChecked="True" Margin="0,4,0,12"/>
        <TextBlock Text="新建、修改时间或重新启用后，从下一次时间点开始。不会补执行生效前的任务。" Foreground="#6B7280" TextWrapping="Wrap"/>
        <TextBlock x:Name="Message" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,8,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" MinWidth="72" Padding="12,5" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="添加计划" IsDefault="True" MinWidth="90" Padding="12,5" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
