<Window Style="{StaticResource AppWindow}" x:Class="AudioDeviceSwitcher.AppAudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="应用音频" Height="560" Width="920" MinWidth="860" MinHeight="400"
        Icon="pack://application:,,,/Resources/app.ico"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="13" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,0,0,8">
            为应用指定输出和输入设备。“跟随系统”使用默认设备；切换音频方案时，以音频方案中的应用设备规则为准。
        </TextBlock>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="刷新" Padding="12,4" Click="Refresh_Click"/>
            <Button Content="全部恢复为跟随系统" Padding="12,4" Margin="8,0,0,0" Click="ClearAll_Click"
                    Foreground="#D32F2F"/>
            <TextBlock x:Name="EmptyHint" Text="尚无音频会话，应用使用音频后会自动显示"
                       VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" Foreground="#6B7280"
                       Visibility="Collapsed"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SessionList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,6" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F9FAFB"/>
                                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDrifted}" Value="True">
                                            <Setter Property="Background" Value="#FFEBEE"/>
                                            <Setter Property="BorderBrush" Value="#D32F2F"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding Icon}" Width="28" Height="28"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                    <TextBlock Text="{Binding RouteStatusText}" Foreground="#6B7280" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SubText}" FontSize="11" Foreground="#6B7280" TextTrimming="CharacterEllipsis" ToolTip="{Binding SubText}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0"
                                            IsEnabled="{Binding HasOutputSession}">
                                    <TextBlock Text="输出音量" FontSize="10" Foreground="#6B7280" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" MinHeight="28">
                                        <CheckBox Content="静音" IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                  VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0"/>
                                        <Slider Width="100" Minimum="0" Maximum="1" SmallChange="0.02" LargeChange="0.1"
                                                Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding VolumePercent}" Width="34" TextAlignment="Right"
                                                   FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="输出" FontSize="10" Foreground="#6B7280"/>
                                        <TextBlock Text=" ⚠ 偏离" FontSize="10" Foreground="#D32F2F" FontWeight="Bold"
                                                   Visibility="{Binding IsOutputDrifted, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <ComboBox Width="180" ItemsSource="{Binding OutputOptions}"
                                              SelectedItem="{Binding SelectedOutput, Mode=TwoWay}"
                                              DisplayMemberPath="Name">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOutputDrifted}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#D32F2F"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="输入" FontSize="10" Foreground="#6B7280"/>
                                        <TextBlock Text=" ⚠ 偏离" FontSize="10" Foreground="#D32F2F" FontWeight="Bold"
                                                   Visibility="{Binding IsInputDrifted, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <ComboBox Width="180" ItemsSource="{Binding InputOptions}"
                                              SelectedItem="{Binding SelectedInput, Mode=TwoWay}"
                                              DisplayMemberPath="Name">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInputDrifted}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#D32F2F"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button Content="关闭" Padding="16,6" HorizontalAlignment="Right" DockPanel.Dock="Right"
                    Click="Close_Click"/>
        </DockPanel>
    </Grid>
</Window>
